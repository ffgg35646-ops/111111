# Copy to .env.local for local development. Never commit real secrets.
MONGODB_URI=
MONGODB_DATABASE=clinical_learning
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_HOST_USER_ID=
ZOOM_TIMEZONE=Africa/Cairo
# Enable Cloud Recording on the Zoom host. The Zoom OAuth app also needs recording:read (or the matching granular Cloud Recording read scope) to publish recordings.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
SUPERVISION_TOKEN_SECRET=
SUPERVISION_ACCESS_CODE=
PLATFORM_SESSION_SECRET=
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD_HASH=
AI_GATEWAY_API_KEY=
CLINICAL_AI_MODEL=openai/gpt-6-astra
OPENAI_API_KEY=
CLINICAL_REALTIME_MODEL=gpt-realtime-2.1
CLINICAL_REALTIME_VOICE=cedar
NEXT_PUBLIC_SAUDI_DOCTOR_AVATAR_MODEL_URL=


# Moyasar prepaid checkout and verified webhook
MOYASAR_SECRET_KEY=
NEXT_PUBLIC_MOYASAR_PUBLISHABLE_KEY=
MOYASAR_WEBHOOK_SECRET=

# Optional email confirmations for consultation bookings (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
NEXT_PUBLIC_APP_URL=
