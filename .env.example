# Copy to .env.local for local development. Never commit real secrets.
MONGODB_URI=
MONGODB_DATABASE=clinical_learning
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_HOST_USER_ID=
ZOOM_TIMEZONE=Africa/Cairo
# Enable Cloud Recording on the Zoom host. The Zoom OAuth app also needs recording:read (or the matching granular Cloud Recording read scope) to publish recordings.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
SUPERVISION_TOKEN_SECRET=
SUPERVISION_ACCESS_CODE=
PLATFORM_SESSION_SECRET=
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD_HASH=
AI_GATEWAY_API_KEY=
CLINICAL_AI_MODEL=openai/gpt-6-astra
OPENAI_API_KEY=
CLINICAL_REALTIME_MODEL=gpt-realtime-2.1
CLINICAL_REALTIME_VOICE=cedar
NEXT_PUBLIC_SAUDI_DOCTOR_AVATAR_MODEL_URL=


# Moyasar prepaid checkout and verified webhook
MOYASAR_SECRET_KEY=
NEXT_PUBLIC_MOYASAR_PUBLISHABLE_KEY=
MOYASAR_WEBHOOK_SECRET=

# Optional email confirmations for consultation bookings (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
NEXT_PUBLIC_APP_URL=

# Authentication/device security
PLATFORM_MAX_DEVICES=2
# Separate 32+ character secret for 5-minute classroom access grants and secure media.
PLATFORM_MEDIA_SECRET=
# Exact hostnames allowed for private MP4/WebM source URLs (comma-separated).
ETZAN_VIDEO_ALLOWED_HOSTS=
# MongoDB TLS is enabled by default except localhost development. Never disable in production.
MONGODB_TLS=true

# Operations: enable encrypted MongoDB Atlas Cloud/Continuous Backups and test restores.

# Optional semantic knowledge retrieval (Atlas Vector Search; disabled until its index is created).
ETZAN_AI_VECTOR_SEARCH_ENABLED=false
ETZAN_AI_VECTOR_INDEX_NAME=etzan_ai_knowledge_vector
ETZAN_AI_EMBEDDING_MODEL=openai/text-embedding-3-small
ETZAN_AI_EMBEDDING_DIMENSIONS=1536
